# ---- Core ----
# Secret used to sign session cookies. CHANGE THIS to a long random string.
# Generate e.g. with:  python -c "import secrets; print(secrets.token_hex(32))"
SECONDTRACK_SECRET_KEY=change-me-to-a-long-random-string

# First-run admin account. After first start you can change the password in the UI.
# These are only used to create the account if no user exists yet.
SECONDTRACK_ADMIN_USER=admin
SECONDTRACK_ADMIN_PASSWORD=changeme

# Path to the SQLite database inside the container (leave as is for Docker).
SECONDTRACK_DB_PATH=/data/secondtrack.db

# Default currency symbol shown in the UI.
SECONDTRACK_CURRENCY=€

# Default hourly rate (can be overridden per project in the UI).
SECONDTRACK_DEFAULT_HOURLY_RATE=45

# Set to 1 only behind HTTPS (recommended in production).
SECONDTRACK_COOKIE_SECURE=0

# ---- Obsidian / Markdown export ----
# Where exported .md files are written. If you mount your vault into the
# container (see compose.yaml), point this at the mount, e.g. /obsidian.
SECONDTRACK_EXPORT_DIR=/data/exports

# ---- WooCommerce (read orders into the hub) ----
# WooCommerce → REST API → create a key pair (read access is enough).
SECONDTRACK_WOO_ENABLED=0
SECONDTRACK_WOO_URL=https://your-shop.example.com
SECONDTRACK_WOO_KEY=ck_xxxxxxxxxxxxxxxx
SECONDTRACK_WOO_SECRET=cs_xxxxxxxxxxxxxxxx
# Which order statuses to show in the hub (comma separated).
SECONDTRACK_WOO_ORDER_STATUSES=processing,completed,on-hold

# ---- InvoiceNinja (the invoicing engine) ----
# Token: InvoiceNinja → Settings → Account Management → API Tokens.
# URL: the public InvoiceNinja URL (also used for deep links).
SECONDTRACK_INVOICENINJA_ENABLED=0
SECONDTRACK_INVOICENINJA_URL=https://invoice.example.com
SECONDTRACK_INVOICENINJA_TOKEN=
# When creating an invoice, immediately email it to the customer
# (InvoiceNinja sends it via its own configured SMTP). 1 = on.
SECONDTRACK_INVOICENINJA_AUTO_SEND=0

# ---- Vikunja (task tracking / Kanban) ----
# Token: Vikunja → Settings → API Tokens (read access to projects & tasks).
SECONDTRACK_VIKUNJA_ENABLED=0
SECONDTRACK_VIKUNJA_URL=https://vikunja.example.com
SECONDTRACK_VIKUNJA_TOKEN=
# Parent project whose subprojects (shop, customers, …) are shown.
SECONDTRACK_VIKUNJA_PARENT_PROJECT=OpenVuture

# ---- Uploads (images, wallpaper) ----
SECONDTRACK_UPLOAD_DIR=/data/uploads
